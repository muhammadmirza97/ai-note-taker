# Optional local Ollama settings.
# The app defaults to these values when the variables are not set.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:1b

# App/security settings.
APP_ENV=development
APP_SECRET_KEY=change-this-before-production
SESSION_COOKIE_NAME=lecture_notes_session
CSRF_COOKIE_NAME=lecture_notes_csrf
SESSION_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Storage and processing.
DATABASE_URL=sqlite:///data/notes.db
MAX_UPLOAD_MB=500
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
ALLOW_DEV_PASSWORD_RESET=true

# Monitoring hook, off unless configured.
SENTRY_DSN=
LOG_LEVEL=INFO
